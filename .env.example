# Complete Glass Innovations - Environment Configuration Example

# PUBLIC SUPABASE CONFIGURATION (Accessible in client browser code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SECURE SERVER-ONLY SUPABASE SERVICE ROLE KEY
# WARNING: NEVER expose this key in client-side code or public repositories.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# EMAIL PROVIDER CONFIGURATION (Server-only)
EMAIL_PROVIDER=resend # Options: resend, mock
EMAIL_API_KEY=re_123456789_your_api_key_here

# BUSINESS CONFIGURATION
BUSINESS_NAME=Complete Glass Innovations
BUSINESS_EMAIL=info@completeglass.com.au
BUSINESS_PHONE=1300 000 000
BUSINESS_ADDRESS=Sydney, NSW, Australia
WEBSITE_URL=https://completeglass.com.au

# APPLICATION CONFIGURATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
