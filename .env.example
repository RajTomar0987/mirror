# Complete Glass Innovations - Environment Configuration Example
# Copy this file to .env.local and fill in your actual production/development credentials.

# 1. PUBLIC SUPABASE CONFIGURATION (Accessible in client browser code)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. SECURE SERVER-ONLY SUPABASE SERVICE ROLE KEY
# WARNING: NEVER expose this key in client-side code, React components, or public repositories.
SUPABASE_SERVICE_ROLE_KEY=

# 3. EMAIL PROVIDER CONFIGURATION (Server-only)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=

# 4. BUSINESS OWNER NOTIFICATION RECIPIENT EMAIL (Server-only)
CONTACT_EMAIL=

# 5. BUSINESS & APPLICATION CONFIGURATION
BUSINESS_NAME=Complete Glass Innovations
BUSINESS_EMAIL=info@completeglass.com.au
BUSINESS_PHONE=1300 000 000
BUSINESS_ADDRESS=Sydney, NSW, Australia
NEXT_PUBLIC_APP_URL=http://localhost:3000
